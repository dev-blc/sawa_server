# ─────────────────────────────────────────────────────────────────────────────
# SAWA server — environment template
#
# Copy to `.env` and fill in real values:  cp .env.example .env
# The server VALIDATES env at boot (src/config/env.ts) and REFUSES to start if a
# required var is missing or malformed. This file is generated from that schema.
# Placeholders only — never commit real secrets (.env is gitignored; this is not).
#
# Legend:  [REQUIRED] boot fails without it   ·   [optional] safe default / feature-gated
# ─────────────────────────────────────────────────────────────────────────────

# ─── Core ────────────────────────────────────────────────────────────────────
# 'development' | 'production' | 'test'                              [optional, default development]
NODE_ENV=development
# HTTP port the server listens on.                                   [optional, default 5000]
PORT=5000
# PostgreSQL connection string (Prisma DATABASE_URL).                [REQUIRED]
DATABASE_URL=postgresql://user:pass@host:5432/sawa

# ─── JWT / auth ──────────────────────────────────────────────────────────────
# Access-token signing secret — MUST be at least 32 characters.     [REQUIRED]
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-min-32-chars
# Refresh-token signing secret — MUST be at least 32 characters.    [REQUIRED]
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string-32
# Access-token lifetime (deliberately 7d — admin panel has no refresh flow).  [optional, default 7d]
JWT_ACCESS_EXPIRES_IN=7d
# Refresh-token lifetime.                                            [optional, default 90d]
JWT_REFRESH_EXPIRES_IN=90d

# ─── CORS / rate limiting ────────────────────────────────────────────────────
# Comma-separated whitelist of allowed origins (no wildcard).       [optional, default http://localhost:8081]
CORS_ORIGINS=http://localhost:8081
# Auth rate-limit window in ms.                                      [optional, default 900000 = 15 min]
RATE_LIMIT_WINDOW_MS=900000
# Max auth requests per IP per window.                               [optional, default 10]
RATE_LIMIT_MAX=10

# ─── Redis ───────────────────────────────────────────────────────────────────
# Redis URL for cache, rate-limit counters, and the Socket.io adapter. When
# unset, an in-process fallback is used (fine for local dev, NOT multi-worker).  [optional]
REDIS_URL=redis://localhost:6379

# ─── Cloudinary (legacy image hosting) ───────────────────────────────────────
CLOUDINARY_CLOUD_NAME=                                              # [optional]
CLOUDINARY_API_KEY=                                                # [optional]
CLOUDINARY_API_SECRET=                                            # [optional]

# ─── S3-compatible object storage (Tigris) — chat voice + images ─────────────
# When unset, images gracefully stay as base64 (deploy-ahead-safe).
S3_ENDPOINT=https://fly.storage.tigris.dev                         # [optional]
S3_REGION=auto                                                     # [optional, default auto]
S3_BUCKET=sawa-media                                               # [optional]
S3_ACCESS_KEY_ID=                                                  # [optional]
S3_SECRET_ACCESS_KEY=                                              # [optional]
# Raw public base URL for the (private) voice bucket — only used for presigning. [optional]
S3_PUBLIC_BASE_URL=
# Dedicated PUBLIC image bucket; falls back to S3_BUCKET when unset.  [optional]
S3_IMAGE_BUCKET=
S3_IMAGE_PUBLIC_BASE_URL=                                          # [optional]
# Hard size caps (bytes) for presigned uploads.                     [optional, defaults 10 MiB / 25 MiB]
S3_MAX_IMAGE_BYTES=10485760
S3_MAX_VOICE_BYTES=26214400

# ─── Public URLs ─────────────────────────────────────────────────────────────
# Base URL of this server — required for the /img image proxy links.  [optional but needed for image storage]
APP_URL=http://localhost:5000
# Auto-populated on some hosts; used as APP_URL fallbacks.           [optional]
RENDER_EXTERNAL_URL=
RAILWAY_PUBLIC_DOMAIN=

# ─── Testing / demo login ────────────────────────────────────────────────────
# Comma-separated phone numbers (with country code) that log in without OTP.
# Ignored in production unless BYPASS_PHONES_ALLOW_PROD is set (see auth.service). [optional]
# App Store review: set BOTH vars on prod with the demo couple's number so the
# Apple reviewer can sign in without SMS (the demo account must exist in the DB;
# no Twilio message is ever sent for bypass numbers). Remove after approval or
# keep scoped to the dedicated review-only account.
BYPASS_PHONES=
# Explicit opt-in required for the bypass to work when NODE_ENV=production. [optional, default off]
BYPASS_PHONES_ALLOW_PROD=

# ─── Twilio / SMS (OTP + partner invites) ────────────────────────────────────
TWILIO_ACCOUNT_SID=                                               # [optional — OTP no-ops until set]
TWILIO_AUTH_TOKEN=                                                # [optional]
TWILIO_PHONE_NUMBER=                                             # [optional]

# ─── SMS abuse guard (spend protection — src/services/abuseGuard.ts) ─────────
# All optional with safe defaults; existing deployments boot unchanged.
# Comma-separated E.164 prefixes SMS may target (India-market).     [optional, default +91]
SMS_ALLOWED_PREFIXES=+91
# Daily caps (UTC day):
SMS_PHONE_DAILY_CAP=6                                              # [optional, default 6]  per destination phone
SMS_PREFIX_DAILY_CAP=30                                            # [optional, default 30] per 8-digit prefix block
SMS_IP_DAILY_CAP=20                                               # [optional, default 20] per caller IP
SMS_DAILY_GLOBAL_CAP=2000                                          # [optional, default 2000] global kill-switch (0 = halt all)
# Ops webhook POSTed (fire-and-forget) the first time a guard layer trips/day.  [optional]
ALERT_WEBHOOK_URL=

# ─── WhatsApp notifications (Twilio) ─────────────────────────────────────────
# Master switch — keep false until a sender + template are approved.  [optional, default false]
WHATSAPP_NOTIFICATIONS_ENABLED=false
# Cycle nudges — parked as a later feature; keep false until the copy is reworked. [optional, default false]
CYCLE_NOTIFIER_ENABLED=false
# WhatsApp-enabled sender, e.g. whatsapp:+14155238886.              [optional]
TWILIO_WHATSAPP_FROM=
# Approved Content Template SID (HX...) — required for prod business msgs.  [optional]
TWILIO_WHATSAPP_CONTENT_SID=
# Notification types NOT mirrored to WhatsApp (comma-separated).    [optional, default message]
WHATSAPP_EXCLUDE_TYPES=message

# ─── AI (Groq) ───────────────────────────────────────────────────────────────
# Groq API key for AI features.                                      [REQUIRED]
GROQ_API_KEY=gsk_your_groq_api_key

# ─── Admin portal ────────────────────────────────────────────────────────────
# Bootstrap admin credentials — both must be set to enable admin login.  [optional]
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ─── Destructive-operation guard ─────────────────────────────────────────────
# Allows POST /admin/flush-database in production. NEVER set true in real prod. [optional, default false]
ALLOW_PROD_DB_FLUSH=false

# ─── Subscriptions — enforcement master switch ───────────────────────────────
# Keep false until the paywall + store products are live, else every existing
# user (no subscription) is locked out. Entitlement is still TRACKED when false. [optional, default false]
SUBSCRIPTIONS_ENFORCED=false

# ─── Apple App Store (server-to-server) ──────────────────────────────────────
APPLE_BUNDLE_ID=com.sawa.application                               # [optional, default com.sawa.application]
APPLE_ISSUER_ID=                                                   # [optional]
APPLE_KEY_ID=                                                      # [optional]
# .p8 private key contents (real newlines or \n-escaped both handled).  [optional]
APPLE_PRIVATE_KEY=
# Numeric App Store app id.                                          [optional]
APPLE_APP_APPLE_ID=
# 'Sandbox' | 'Production'.                                          [optional, default Sandbox]
APPLE_ENVIRONMENT=Sandbox
APPLE_PRODUCT_PRIME_MONTHLY=sawa_prime_monthly                     # [optional]
APPLE_PRODUCT_PRIME_YEARLY=sawa_prime_yearly                       # [optional]

# ─── Google Play Billing ─────────────────────────────────────────────────────
GOOGLE_PLAY_PACKAGE_NAME=com.sawa.couplesapp                       # [optional, default com.sawa.couplesapp]
# Service-account JSON (Google Play Android Developer API enabled).  [optional]
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
GOOGLE_PRODUCT_PRIME_MONTHLY=sawa_prime_monthly                   # [optional]
GOOGLE_PRODUCT_PRIME_YEARLY=sawa_prime_yearly                     # [optional]
# Shared secret appended as ?secret=... to the RTDN Pub/Sub push URL (defense in depth). [optional]
GOOGLE_RTDN_SECRET=
